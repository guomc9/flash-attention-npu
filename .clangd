# clangd 配置：仅供 IDE 解析 Ascend C / Catlass 源码，不参与真实构建。
# 真实构建由 setup.py 通过 bisheng 完成；此处走 CANN 的 CPU 调试(ASCENDC_CPU_DEBUG)分支，
# 让 AscendC 头文件在 host clang 下可解析。
#
# 本文件不含任何机器/用户相关路径（相对路径均相对各源文件所在目录解析）。
# torch/torch_npu/Python 头文件路径属机器相关配置，请写入用户级配置
# ~/.config/clangd/config.yaml，例如：
#   CompileFlags:
#     Add:
#       - "-isystem"
#       - "/usr/include/python3.12"
#       - "-isystem"
#       - "<venv>/lib/python3.12/site-packages/torch/include"
#       - "-isystem"
#       - "<venv>/lib/python3.12/site-packages/torch/include/torch/csrc/api/include"
#       - "-isystem"
#       - "<venv>/lib/python3.12/site-packages/torch_npu/include"

CompileFlags:
  Add:
    - "-std=c++17"
    - "-stdlib=libstdc++"

    # catlass tla/*.hpp 裸用 size_t 未包含 <cstddef>，预包含补齐
    - "-include"
    - "cstddef"

    # 走 CANN 头文件的 CPU 仿真分支（自含 stub_def.h，提供 half/__aicore__ 等）
    - "-DASCENDC_CPU_DEBUG=1"
    # 否则 AscendC::DT_FLOAT 等枚举在 host 解析下退化为裸宏 0
    - "-D__NPU_DEVICE__"
    # stub_def.h 未覆盖的关键字
    - "-D__forceinline__=inline"
    - "-D__global__="
    - "-D__aicpu__="
    - "-D__device__="
    - "-D__launch_bounds__(x)="

    # CANN AscendC 头文件（asc/ 根必须在列表中：头文件内部大量 #include "impl/..." 相对路径）
    - "-isystem"
    - "/usr/local/Ascend/cann/x86_64-linux/asc"
    - "-isystem"
    - "/usr/local/Ascend/cann/x86_64-linux/asc/include"
    - "-isystem"
    - "/usr/local/Ascend/cann/x86_64-linux/asc/include/basic_api"
    - "-isystem"
    - "/usr/local/Ascend/cann/x86_64-linux/asc/include/interface"
    - "-isystem"
    - "/usr/local/Ascend/cann/x86_64-linux/asc/include/c_api"
    - "-isystem"
    - "/usr/local/Ascend/cann/x86_64-linux/asc/include/simt_api"
    - "-isystem"
    - "/usr/local/Ascend/cann/x86_64-linux/asc/include/aicpu_api"
    - "-isystem"
    - "/usr/local/Ascend/cann/x86_64-linux/asc/include/tiling"
    - "-isystem"
    - "/usr/local/Ascend/cann/x86_64-linux/asc/include/utils"
    - "-isystem"
    - "/usr/local/Ascend/cann/x86_64-linux/asc/impl"
    - "-isystem"
    - "/usr/local/Ascend/cann/x86_64-linux/asc/impl/basic_api"
    - "-isystem"
    - "/usr/local/Ascend/cann/x86_64-linux/include"
    # 高级 API（lib/matmul_intf.h 等）和 host 侧 tiling API
    - "-isystem"
    - "/usr/local/Ascend/cann/x86_64-linux/include/ascendc/highlevel_api"
    - "-isystem"
    - "/usr/local/Ascend/cann/x86_64-linux/include/ascendc/host_api"
    # CPU 调试 stub（half, bfloat16_t, threadIdx 等），ASCENDC_CPU_DEBUG=1 时被 CANN 头引用
    - "-isystem"
    - "/usr/local/Ascend/cann/tools/cpudebug/include"

    # fag_kernel.cpp 先包含 catlass，而 catlass.hpp 只在 __CCE__ 下才引 kernel_operator.h；
    # 不能定义 __CCE__（会让 CATLASS_HOST_DEVICE 展开成 bisheng 专属属性），故预包含
    - "-include"
    - "kernel_operator.h"

    - "-Wno-unknown-attributes"
    - "-Wno-ignored-attributes"
    - "-Wno-gnu-zero-variadic-macro-arguments"
    - "-Wno-nested-anon-types"

Diagnostics:
  UnusedIncludes: None
  MissingIncludes: None
  Suppress:
    - "pp_file_not_found"       # 构建期生成的头文件
    - "unknown-warning-option"  # 自定义 -Wno-* 可能不被 clangd 内置 clang 识别
    - "macro-redefined"         # CANN 头文件内部重复定义 __BLOCK_LOCAL__ 等
    - "attributes_not_allowed"  # bisheng 专属属性在 host clang 下的噪声
    # CPU 调试模式下 half 是类类型，catlass 头中 constexpr half 初始化报非常量，仅 IDE 噪声
    - "constexpr_var_requires_const_init"

# ---- ascend950 v3（按版本目录隔离，避免 v3/v4 同名全局函数歧义，与 setup.py 一致）----
# 相对路径相对源文件所在目录解析：本目录上三级为仓库根
---
If:
  PathMatch: "csrc/ascend950/flash_attn_npu_3/[^/]+$"
CompileFlags:
  Add:
    - "-D__NPU_ARCH__=3510"
    - "-DCATLASS_ARCH=3510"
    - "-D__DAV_VEC__"
    - "-isystem"
    - "../../../csrc/catlass/include"
    # kernel_common.hpp 等被包含式头缺少独立 include 上下文时由 catlass 宏头补齐
    - "-include"
    - "catlass/detail/macros.hpp"

# ---- ascend950 v3 autogen（目录层级多一层）----
---
If:
  PathMatch: "csrc/ascend950/flash_attn_npu_3/autogen/[^/]+$"
CompileFlags:
  Add:
    - "-D__NPU_ARCH__=3510"
    - "-DCATLASS_ARCH=3510"
    - "-D__DAV_VEC__"
    - "-isystem"
    - "../../../../csrc/catlass/include"
    - "-include"
    - "catlass/detail/macros.hpp"

# ---- ascend950 v4 ----
---
If:
  PathMatch: "csrc/ascend950/flash_attn_npu_4/[^/]+$"
CompileFlags:
  Add:
    - "-D__NPU_ARCH__=3510"
    - "-DCATLASS_ARCH=3510"
    - "-D__DAV_VEC__"
    - "-isystem"
    - "../../../csrc/catlass/include"
    - "-include"
    - "catlass/detail/macros.hpp"

# ---- ascend950 v4 autogen ----
---
If:
  PathMatch: "csrc/ascend950/flash_attn_npu_4/autogen/[^/]+$"
CompileFlags:
  Add:
    - "-D__NPU_ARCH__=3510"
    - "-DCATLASS_ARCH=3510"
    - "-D__DAV_VEC__"
    - "-isystem"
    - "../../../../csrc/catlass/include"
    - "-include"
    - "catlass/detail/macros.hpp"

# ---- fai_kernel.cpp 使用 FAIKernelParams 但未自行包含其定义（真实构建中由
#      fai_host_api_impl.hpp 先行包含 kernel_common.hpp），独立解析时预包含补齐 ----
---
If:
  PathMatch: "csrc/ascend950/.*/fai_kernel\\.cpp"
CompileFlags:
  Add:
    - "-include"
    - "kernel_common.hpp"

# ---- host 侧包含 <<<blocks, tiling, stream>>> 核启动语法的文件，clang 无法解析 ----
---
If:
  PathMatch: "csrc/ascend950/.*/mha_bwd\\.cpp"
CompileFlags:
  Add:
    - "-ferror-limit=0"
Diagnostics:
  Suppress:
    - "expected_expression"
    - "expected_lparen_after_type"
